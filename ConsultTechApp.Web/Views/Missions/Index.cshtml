@using ConsultTechApp.Web.ViewsModels.Missions
@model MissionsListViewModel

@{
    ViewData["Title"] = "Missions";
}

<div class="row">
    <div class="col-6 d-flex align-items-center justify-content-start">
        <h1>Missions</h1>
    </div>
    <div class="col-6 d-flex align-items-center justify-content-end">
        <a asp-action="Create" class="btn btn-primary">Add mission</a>
    </div>
</div>
<div class="row">
    <div class="col-12 table-responsive mt-3">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th class="text-center">Title</th>
                    <th class="text-center">Description</th>
                    <th class="text-center">StartDate</th>
                    <th class="text-center">EndDate</th>
                    <th class="text-center">EstimatedBudget</th>
                    <th class="text-center">Customer</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mission in Model.Items)
                {
                    <tr>
                        <td class="text-center">@mission.Title</td>
                        <td class="text-center">@mission.Description</td>
                        <td class="text-center">@(mission.StartDate.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td class="text-center">@(mission.EndDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td class="text-center">@mission.EstimatedBudget</td>
                        <td class="text-center">@mission.Customer</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@mission.Id" class="btn btn-info">Detail</a>
                            <a asp-action="Edit" asp-route-id="@mission.Id" class="btn btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@mission.Id" class="btn btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>