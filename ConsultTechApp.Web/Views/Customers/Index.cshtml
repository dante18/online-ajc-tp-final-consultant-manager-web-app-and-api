@using ConsultTechApp.Web.ViewsModels.Customers
@model CustomersListViewModel

@{
    ViewData["Title"] = "Customers";
}

<div class="row">
    <div class="col-6 d-flex align-items-center justify-content-start">
        <h1>Customers</h1>
    </div>
    <div class="col-6 d-flex align-items-center justify-content-end">
        <a asp-action="Create" class="btn btn-primary">Add customer</a>
    </div>
</div>
<div class="row">
    <div class="col-12 table-responsive mt-3">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th class="text-center">Customer Name</th>
                    <th class="text-center">Sector of activity</th>
                    <th class="text-center">Address</th>
                    <th class="text-center">Contact Name</th>
                    <th class="text-center">Contact Email</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model.Items)
                {
                    <tr>
                        <td class="text-center">@customer.CompanyName</td>
                        <td class="text-center">@customer.Industry</td>
                        <td class="text-center">@customer.Address</td>
                        <td class="text-center">@customer.ContactName</td>
                        <td class="text-center">@customer.ContactEmail</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-info">Detail</a>
                            <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@customer.Id" class="btn btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>