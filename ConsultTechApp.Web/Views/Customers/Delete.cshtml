@using ConsultTechApp.Web.ViewsModels.Customers
@model CustomersDeleteViewModel

@{
    ViewData["Title"] = "Customer delete - " + @Model.CompanyName;
}

<div class="row">
    <div class="col-6 d-flex align-items-center justify-content-start mt-3">
        <h1>Delete @Model.CompanyName informations</h1>
    </div>
    <div class="col-6 d-flex align-items-center justify-content-end">
        <a asp-action="Index" class="btn btn-primary">Cancel and return to the customer list</a>
    </div>
</div>
<div class="row">
    <div class="col-12 d-flex align-items-center justify-content-start">
        <h3>Are you sure you want to delete this customer?</h3>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="table-responsive">
            <table class="table table-bordered">
                <tbody>
                <tr>
                    <td style="width: 30%">
                        Customer Name
                    </td>
                    <td>@(Model.CompanyName)</td>
                </tr>
                <tr>
                    <td style="width: 30%">
                        Sector of activity
                    </td>
                    <td>@(Model.Industry)</td>
                </tr>
                <tr>
                    <td style="width: 30%">
                        Address
                    </td>
                    <td>@(Model.Address)</td>
                </tr>
                <tr>
                    <td style="width: 30%">
                        Contact Name
                    </td>
                    <td>@(Model.ContactName)</td>
                </tr>
                <tr>
                    <td style="width: 30%">
                        Contact Email
                    </td>
                    <td>
                        @(Model.ContactEmail)
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12 d-flex align-items-center justify-content-start">
        <div>
            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="form-group">
                    <input type="submit" value="Delete" class="btn btn-danger" />
                </div>
            </form>
        </div>
    </div>
</div>
